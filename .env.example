# Copy to .env and fill in. Never commit .env.

# === ROS 2 ===
# ROS_DOMAIN_ID=0
# RMW_IMPLEMENTATION=rmw_cyclonedds_cpp

# === YOLO inference (container) ===
# YOLO_WEIGHTS=/weights/best.pt        # path inside container (mount target)
# WEIGHTS_PATH=                        # path on host (used by yolo_dockerfile/run.sh)

# === Docker ===
# IMAGE_NAME=smartwarehouse-yolo:latest

# === Hardware gating (Hard Rule #4) ===
# REAL_ROBOT=0                         # 1 only when connecting to physical M0609
# ROBOT_IP=                            # M0609 controller IP (required when REAL_ROBOT=1)

# === Feature flags (default OFF) ===
# DEBUG_VISUALIZATION=0
